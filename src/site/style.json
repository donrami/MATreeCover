{
  "version": 8,
  "name": "Mannheim Tree Cover",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sprite": "",
  "metadata": {},
  "sources": {
    "basemap": {
      "type": "raster",
      "tiles": [
        "https://sgx.geodatenzentrum.de/wmts_basemapde/tile/1.0.0/de_basemapde_web_raster_grau/default/GLOBAL_WEBMERCATOR/{z}/{y}/{x}.png"
      ],
      "tileSize": 256,
      "attribution": "© basemap.de / LGL"
    },
    "boundary": {
      "type": "geojson",
      "data": "boundary.geojson"
    },
    "buildings": {
      "type": "vector",
      "url": "pmtiles://buildings.pmtiles",
      "attribution": "Datenquelle: LGL, dl-de/by-2-0"
    },
    "trees": {
      "type": "vector",
      "url": "pmtiles://trees.pmtiles",
      "attribution": "Datenquelle: LGL, dl-de/by-2-0"
    }
  },
  "layers": [
    {
      "id": "basemap",
      "type": "raster",
      "source": "basemap",
      "layout": { "visibility": "visible" },
      "paint": { "raster-brightness-max": 0.65 }
    },
    {
      "id": "basemap-inverted",
      "type": "raster",
      "source": "basemap",
      "layout": { "visibility": "none" },
      "paint": {
        "raster-brightness-min": 0.65,
        "raster-brightness-max": 0,
        "raster-opacity": 0
      }
    },
    {
      "id": "outside-mask",
      "type": "fill",
      "source": "boundary",
      "paint": {
        "fill-color": "#000000",
        "fill-opacity": 1
      }
    },
    {
      "id": "buildings-fill",
      "type": "fill",
      "source": "buildings",
      "source-layer": "buildings",
      "paint": {
        "fill-color": [
          "case",
          ["==", ["get", "has_value"], true],
          [
            "interpolate",
            ["linear"],
            ["get", "value"],
            0, "#ffd524",
            12, "#e6854a",
            24, "#a97e65",
            24.08, "#0674aa",
            32, "#1db6ff",
            40, "#39c2ff",
            48, "#56ceff",
            80, "#6ad4ff"
          ],
          "#b8b8b8"
        ],
        "fill-opacity": [
          "case",
          ["==", ["get", "has_value"], true],
          0.75,
          0.8
        ]
      }
    },
    {
      "id": "buildings-line",
      "type": "line",
      "source": "buildings",
      "source-layer": "buildings",
      "paint": {
        "line-color": "#555555",
        "line-width": 0.5
      }
    },
    {
      "id": "trees-fill",
      "type": "fill",
      "source": "trees",
      "source-layer": "trees",
      "layout": { "visibility": "none" },
      "paint": {
        "fill-color": "#39C43D",
        "fill-opacity": 0.75
      }
    }
  ]
}
