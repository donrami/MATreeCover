# OR-005 / R-012: large data files never enter git.
# > 50 MiB GeoJSON is enforced by `make check-or005` (git can't size-filter);
# small GeoJSON test fixtures under tests/ stay tracked.
*.tif
*.pmtiles
dist/
data/
mosaic/

# Archive of the prior mannheim workspace (never public). Kept in-repo for
# reproduction after Desktop/mannheim is deleted; the manifest records
# paths/sizes/sha256 (OR-005). Point MANNHEIM_WORKSPACE at
# data/archive/workspace to run the pipeline/tests against it.
data/archive/

# Model weights (CityTreeCover DeepLabV3+ ResNet34, MIT)
*.pth

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Cloudflare worker tooling (workers/map)
node_modules/
.wrangler/
workers/map/wrangler.local.toml

# Owner-infra gate config (FR-014 continuity checks)
scripts/deploy-cf.env

# Local release archives kept for rollback (deploy-cf.sh)
dist-archive/

# Filtered assets copy staged by deploy-cf.sh prepare-assets
dist-assets/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Logs
*.log

# CLI wrapper internals (per-invocation time/inputs scratch)
validation/.time.*
validation/.inputs.*

# Tooling / local harness (never public)
.omp/
.specify/
.spec-workflow/

# Secrets
.env*
*.pem
*.key
*.crt
*.p12
*.jks
*.secret.*
